/* ===== 步骤指示器 ===== */
.ts { padding: 32rpx 32rpx 80rpx; }
.ts--style-step {
  padding-bottom: calc(220rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}
.ts__steps {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 0 40rpx;
}
.ts__step { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.ts__step-dot {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #ececec; color: #aaa;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 600;
  transition: all .25s;
}
.ts__step-label { font-size: 22rpx; color: #999; margin-top: 10rpx; }
.ts__step.on .ts__step-dot {
  background: linear-gradient(135deg, #ff5e8a, #9b6cff);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(255,94,138,0.3);
}
.ts__step.on .ts__step-label { color: #333; font-weight: 600; }
.ts__step-line {
  flex: 1; height: 4rpx; background: #ececec; margin: 0 12rpx;
  position: relative; top: -16rpx;
  transition: background .25s;
}
.ts__step-line.on { background: linear-gradient(90deg, #ff5e8a, #9b6cff); }

/* ===== 标题 ===== */
.ts__title { font-size: 40rpx; font-weight: 700; margin-bottom: 12rpx; color: #1a1a1a; }
.ts__sub   { font-size: 26rpx; color: #888; line-height: 1.6; margin-bottom: 36rpx; }

/* ===== Step 1：甲型选择（分组） ===== */
.ts__shape-group { margin-bottom: 36rpx; }
.ts__shape-group-title {
  display: inline-block;
  font-size: 24rpx;
  font-weight: 600;
  color: #7c3aed;
  background: rgba(155,108,255,0.12);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin-bottom: 18rpx;
  letter-spacing: 1rpx;
}
.ts__shapes {
  display: flex; flex-wrap: wrap; gap: 20rpx;
}
.ts__shape-card {
  flex: 1;
  min-width: 180rpx;
  background: #fff; border-radius: 24rpx; padding: 28rpx 20rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  transition: all .2s;
}
.ts__shape-card.on {
  border-color: #9b6cff;
  background: linear-gradient(135deg, #f5f0ff, #fff5f8);
  box-shadow: 0 8rpx 28rpx rgba(155,108,255,0.18);
  transform: translateY(-4rpx);
}
.ts__shape-name { font-size: 30rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 8rpx; }
.ts__shape-desc { font-size: 22rpx; color: #999; line-height: 1.5; }

.ts__cta { margin-top: 48rpx; }

/* ===== Step 2：上传 ===== */
.ts__upload {
  position: relative;
  width: 100%; aspect-ratio: 4/3;
  border-radius: 24rpx;
  background: #fafafa;
  border: 3rpx dashed #d0d0d0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
}
.ts__upload--has-photo {
  aspect-ratio: auto;
  height: auto;
  min-height: 0;
  padding: 16rpx;
  overflow: visible;
  background: #f3f3f3;
  border-style: solid;
}
.ts__upload-actions {
  display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 28rpx; width: 86%;
  justify-content: center;
}
.ts__pick-btn {
  flex: 1; margin: 0; padding: 0; height: 76rpx; line-height: 76rpx;
  font-size: 28rpx; border-radius: 999rpx;
  background: #fff !important; color: #333 !important;
  border: 2rpx solid #ddd !important;
}
.ts__pick-btn::after { border: none; }
.ts__pick-btn--primary {
  background: linear-gradient(135deg, #ff5e8a, #9b6cff) !important;
  color: #fff !important; border: none !important;
}
.ts__pick-btn--hover { opacity: 0.88; }
.ts__upload-icon {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: linear-gradient(135deg, #ff5e8a, #9b6cff);
  color: #fff; font-size: 56rpx; line-height: 92rpx;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255,94,138,0.28);
}
.ts__upload-text { font-size: 30rpx; color: #333; font-weight: 500; }
.ts__upload-tip  { font-size: 22rpx; color: #aaa; margin-top: 10rpx; }
.ts__upload-img  { width: 100%; height: 100%; }
.ts__upload-img--fit {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 12rpx;
}
.ts__mock-tag {
  position: absolute; left: 20rpx; top: 20rpx;
  background: rgba(255,94,138,0.92); color: #fff;
  font-size: 22rpx; padding: 8rpx 18rpx; border-radius: 999rpx;
}
.ts__upload-clear {
  position: absolute; right: 20rpx; top: 20rpx;
  width: 52rpx; height: 52rpx; border-radius: 50%;
  background: rgba(0,0,0,0.55); color: #fff;
  font-size: 28rpx; line-height: 52rpx; text-align: center;
}

.ts__eval { margin-top: 24rpx; }
.ts__eval-title { font-size: 26rpx; color: #666; margin-bottom: 16rpx; }
.ts__eval-scroll { white-space: nowrap; }
.ts__eval-item {
  display: inline-block; width: 128rpx; margin-right: 16rpx;
  vertical-align: top; border: 3rpx solid transparent; border-radius: 14rpx;
  padding: 4rpx; transition: border-color .2s;
}
.ts__eval-item.on { border-color: #ff5e8a; }
.ts__eval-thumb {
  width: 120rpx; height: 120rpx; border-radius: 10rpx; display: block;
  background: #eee;
  object-fit: contain;
}
.ts__eval-thumb--local { opacity: 0.85; }
.ts__eval-name {
  font-size: 20rpx; color: #666; text-align: center; margin-top: 8rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.ts__back-row {
  margin-top: 36rpx;
  display: flex; flex-direction: column; gap: 20rpx;
}
.ts__back-row--sticky {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  z-index: 10;
  margin-top: 0;
  padding: 20rpx 0 calc(24rpx + constant(safe-area-inset-bottom));
  padding: 20rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247,247,251,0), rgba(247,247,251,0.96) 22%, #f7f7fb 100%);
}
.ts__back-row--sticky .np-btn {
  box-shadow: 0 12rpx 30rpx rgba(255,94,138,0.24);
}
.ts__back { font-size: 26rpx; color: #888; text-align: center; padding: 12rpx; }
.ts__compose-btn { width: 100%; }

/* ===== Step 3：预览 ===== */
.ts__stage {
  position: relative; width: 100%; aspect-ratio: 3/4;
  background: #f5f5f5; border-radius: 24rpx; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.ts__photo { width: 100%; height: 100%; }
.ts__retake {
  position: absolute; right: 24rpx; bottom: 24rpx;
  padding: 14rpx 28rpx; background: rgba(0,0,0,0.6); color: #fff;
  border-radius: 999rpx; font-size: 24rpx;
}

.ts__current {
  margin: 28rpx 0 12rpx;
  background: #fff; border-radius: 18rpx; padding: 24rpx;
}
.ts__current-row { display: flex; align-items: center; gap: 16rpx; }
.ts__current-tag {
  font-size: 22rpx; color: #ff5e8a;
  background: #fff0f5; padding: 4rpx 14rpx; border-radius: 999rpx;
}
.ts__current-name { font-size: 30rpx; font-weight: 600; color: #1a1a1a; }
.ts__current-shape { font-size: 24rpx; color: #888; margin-top: 10rpx; }
.ts__ratings {
  margin: 16rpx 0 12rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.ts__rating {
  padding: 22rpx 24rpx;
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 18rpx rgba(255,94,138,0.08);
}
.ts__rating-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ts__rating-title { font-size: 28rpx; font-weight: 600; color: #333; }
.ts__rating-value { font-size: 24rpx; color: #ff5e8a; }
.ts__rating half-star-rating {
  display: block;
  margin-top: 14rpx;
}
.ts__rating-submit {
  margin-top: 4rpx;
}
.ts__rating-locked-hint {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #888;
  text-align: center;
}

.ts__switch { margin-top: 28rpx; }
.ts__switch-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; color: #333; }
.ts__alts { white-space: nowrap; }
.ts__alt {
  display: inline-block; margin-right: 16rpx;
  vertical-align: top;
  border: 3rpx solid transparent; border-radius: 14rpx; padding: 4rpx;
  transition: border-color .2s;
}
.ts__alt.on { border-color: #ff5e8a; }
.ts__alt-cover { width: 160rpx; height: 213rpx; border-radius: 12rpx; display: block; }
.ts__alt-name { font-size: 22rpx; color: #555; text-align: center; margin-top: 8rpx; max-width: 168rpx; overflow: hidden; text-overflow: ellipsis; }

/* ===== 选款式 step（首页直接进试戴时） ===== */
.ts__empty { text-align: center; color: #999; font-size: 26rpx; padding: 60rpx 0; }
.ts__style-hint {
  font-size: 24rpx; color: #999; margin-bottom: 20rpx; line-height: 1.5;
}
.ts__style-grid {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx;
}
.ts__style-cover--upload {
  background: linear-gradient(135deg, #fff0f5, #f3eeff);
  border: 2rpx dashed #ffb8cc;
}
.ts__style-upload-icon {
  font-size: 64rpx; color: #ff5e8a; font-weight: 300; line-height: 1;
}
.ts__style-card {
  background: #fff; border-radius: 18rpx; overflow: hidden;
  border: 3rpx solid transparent;
  transition: all .2s;
}
.ts__style-card.on {
  border-color: #ff5e8a;
  box-shadow: 0 8rpx 24rpx rgba(255,94,138,0.18);
  transform: translateY(-4rpx);
}
.ts__style-cover {
  position: relative; width: 100%; aspect-ratio: 3/4;
  background: linear-gradient(135deg, #ffd1dc, #d6c2ff);
  display: flex; align-items: center; justify-content: center;
}
.ts__style-img { width: 100%; height: 100%; }
.ts__style-fallback {
  color: #fff; font-size: 28rpx; font-weight: 600; padding: 0 16rpx; text-align: center;
}
.ts__style-metrics {
  position: absolute; left: 12rpx; right: 12rpx; bottom: 12rpx;
  display: flex; align-items: center; max-width: calc(100% - 24rpx);
  overflow: hidden; border-radius: 999rpx;
  background: rgba(255,255,255,0.88);
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.08);
}
.ts__style-metric {
  padding: 4rpx 8rpx; font-size: 18rpx; color: #4a3a42; white-space: nowrap;
}
.ts__style-metric + .ts__style-metric {
  border-left: 1rpx solid rgba(255,94,138,0.18); color: #b45309;
}
.ts__style-check {
  position: absolute; top: 12rpx; right: 12rpx;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: #ff5e8a; color: #fff;
  font-size: 28rpx; line-height: 44rpx; text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(255,94,138,0.4);
}
.ts__style-name {
  font-size: 26rpx; color: #333; padding: 14rpx 16rpx;
  font-weight: 500;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* 已选款式提示（photo step 上方） */
.ts__chosen {
  display: flex; align-items: center; flex-wrap: wrap;
  background: #fff5f8; border-radius: 12rpx;
  padding: 18rpx 24rpx; margin-bottom: 24rpx;
  font-size: 26rpx; color: #333;
}
.ts__chosen-tag {
  font-size: 22rpx; color: #ff5e8a;
  background: #fff; padding: 4rpx 14rpx; border-radius: 999rpx;
  margin-right: 14rpx;
}
.ts__chosen-name { font-weight: 600; }
.ts__chosen-shape { color: #888; margin-left: 10rpx; }
.ts__chosen--tap { cursor: pointer; }
.ts__chosen-change {
  margin-left: auto; font-size: 24rpx; color: #ff5e8a;
}

.ts__wan-model {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #f7f7fb;
  border-radius: 16rpx;
  border: 1rpx solid #ececf0;
}
.ts__wan-model-title { font-size: 26rpx; font-weight: 600; color: #333; margin-bottom: 12rpx; }
.ts__wan-model-pick {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 20rpx; background: #fff; border-radius: 12rpx;
  font-size: 26rpx; color: #1a1a1a;
}
.ts__wan-model-arrow { font-size: 20rpx; color: #999; }
.ts__wan-model-tip { font-size: 22rpx; color: #999; margin-top: 10rpx; }
.ts__current-model { font-size: 24rpx; color: #666; margin-top: 8rpx; }

/* 合成等待动效（CSS 动画，无需外链 GIF） */
.ts__compose-overlay {
  position: absolute; inset: 0; z-index: 4;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 48rpx 40rpx;
  background: linear-gradient(165deg, rgba(255,94,138,0.92), rgba(155,108,255,0.88));
  color: #fff;
  text-align: center;
}
.ts__compose-anim {
  position: relative;
  width: 188rpx; height: 188rpx;
  margin-bottom: 36rpx;
  flex-shrink: 0;
}
.ts__compose-ring {
  position: absolute; inset: 0;
  border-radius: 50%;
  border: 5rpx solid rgba(255,255,255,0.22);
  border-top-color: #fff;
  border-right-color: rgba(255,255,255,0.7);
  animation: ts-compose-spin 0.95s linear infinite;
  box-sizing: border-box;
}
.ts__compose-logo {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 148rpx; height: 148rpx;
  border-radius: 50%;
  z-index: 2;
}
.ts__compose-title {
  font-size: 34rpx; font-weight: 700; margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}
.ts__compose-msg {
  font-size: 28rpx; line-height: 1.5;
  min-height: 84rpx;
  opacity: 0.95;
  transition: opacity 0.3s;
}
.ts__compose-bar {
  width: 100%; max-width: 480rpx; height: 12rpx;
  margin-top: 32rpx; border-radius: 999rpx;
  background: rgba(255,255,255,0.25);
  overflow: hidden;
}
.ts__compose-bar-fill {
  height: 100%; border-radius: 999rpx;
  background: #fff;
  transition: width 1s linear;
  max-width: 92%;
}
.ts__compose-hint {
  margin-top: 20rpx; font-size: 22rpx; opacity: 0.85;
}

@keyframes ts-compose-spin {
  to { transform: rotate(360deg); }
}
