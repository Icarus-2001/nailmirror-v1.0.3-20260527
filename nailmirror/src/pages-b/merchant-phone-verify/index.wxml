<view class="mpv np-container">
  <view class="mpv__card">
    <view class="mpv__title">验证商家手机号</view>
    <view class="mpv__desc">为保障商家账号安全，进入商家中心前需验证认证时绑定的手机号。</view>
    <view class="mpv__phone" wx:if="{{phoneMasked}}">认证手机号：{{phoneMasked}}</view>
    <view class="mpv__hint">请使用上方号码对应的微信账号授权验证（微信手机号快捷验证）。</view>
    <button
      class="mpv__btn np-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      loading="{{verifying}}"
      disabled="{{verifying}}"
    >微信手机号快捷验证</button>
  </view>
  <view class="mpv__back" bindtap="onBack">返回</view>
  <privacy-popup />
</view>
