<view class="ns np-container">
  <view class="ns__title">选择你的甲型</view>
  <view class="ns__hint">试戴前必选，后续识别关键点将根据甲型适配</view>

  <view wx:for="{{shapeGroups}}" wx:key="groupLabel" class="ns__group">
    <view class="ns__group-title">{{item.groupLabel}}</view>
    <view class="ns__row">
      <view
        wx:for="{{item.shapes}}" wx:for-item="shape" wx:key="id"
        class="ns__card {{selected === shape.id ? 'ns__card--on' : ''}}"
        data-v="{{shape.id}}" bindtap="onPick">
        <view class="ns__label">{{shape.label}}</view>
        <view class="ns__desc">{{shape.desc}}</view>
      </view>
    </view>
  </view>

  <view class="ns__bottom">
    <button class="np-btn np-btn--block" bindtap="onNext" disabled="{{!selected}}">下一步，选款式</button>
  </view>
</view>
