.me { padding: 24rpx; }
.me__header { background: rgba(255,255,255,0.94); border-radius: 28rpx; padding: 40rpx 28rpx; display: flex; align-items: center; box-shadow: 0 14rpx 36rpx rgba(31,31,41,0.06); margin-bottom: 24rpx; }
.me__header-arrow { color: var(--np-primary); font-size: 40rpx; margin-left: 8rpx; }
.me__name--login { color: var(--np-primary); }
.me__avatar { display: block; width: 120rpx; height: 120rpx; border-radius: 50%; background: #eee; margin-right: 24rpx; overflow: hidden; }
.me__name { font-size: 36rpx; font-weight: 600; }
.me__role { color: var(--np-text-weak); font-size: 24rpx; margin-top: 6rpx; }
.me__menu { background: rgba(255,255,255,0.94); border-radius: 24rpx; padding: 0 24rpx; box-shadow: 0 10rpx 30rpx rgba(31,31,41,0.05); }
.me__menu-item { display: flex; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid var(--np-border); font-size: 28rpx; }
.me__menu-item:last-child { border-bottom: 0; }
.me__menu-icon { font-size: 32rpx; margin-right: 18rpx; }
.me__menu-label { flex: 1; }
.me__menu-arrow { color: var(--np-text-weak); font-size: 32rpx; }
