.sd { padding-bottom: 140rpx; }
.sd__swiper { width: 100%; height: 900rpx; }
.sd__img { width: 100%; height: 900rpx; }
.sd__head-row { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.sd__title { font-size: 40rpx; font-weight: 700; flex: 1; min-width: 0; }
.sd__source { flex-shrink: 0; padding: 6rpx 16rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 500; }
.sd__source--xhs { background: rgba(255,94,138,0.12); color: #ff5e8a; }
.sd__source--merchant { background: rgba(155,108,255,0.12); color: #7c3aed; }
.sd__source--platform { background: rgba(255,94,138,0.12); color: #ff5e8a; }
.sd__brief { color: var(--np-text-weak); margin: 14rpx 0 20rpx; font-size: 26rpx; line-height: 1.6; }
.sd__tags { display: flex; flex-wrap: wrap; }
.sd__metrics { margin-top: 24rpx; display: flex; flex-wrap: wrap; align-items: center; gap: 20rpx; }
.sd__heat { color: var(--np-danger); font-size: 28rpx; }
.sd__tryon { color: #7c3aed; font-size: 28rpx; font-weight: 500; }
.sd__quality { color: #b45309; font-size: 28rpx; font-weight: 500; }
.sd__merchant { margin-top: 32rpx; padding: 24rpx; background: var(--np-card); border-radius: 16rpx; }
.sd__phone { color: var(--np-primary, #ff5e8a); font-size: 26rpx; margin-top: 8rpx; text-decoration: underline; }
.sd__bottom { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-top: 1rpx solid var(--np-border); padding: 20rpx 24rpx; display: flex; align-items: center; gap: 20rpx; }
.sd__fav { font-size: 26rpx; color: var(--np-primary); }
.sd__contact { font-size: 26rpx; color: var(--np-text); }
.sd__try { flex: 1; }
