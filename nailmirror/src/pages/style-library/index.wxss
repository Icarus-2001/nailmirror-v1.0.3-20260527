.lib { padding: 24rpx 24rpx 40rpx; }
.lib__search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.lib__input-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.97);
  border-radius: 999rpx;
  padding: 0 12rpx 0 24rpx;
  height: 76rpx;
  box-shadow: 0 10rpx 30rpx rgba(31,31,41,0.05);
}
.lib__input { flex: 1; min-width: 0; font-size: 28rpx; }
.lib__search-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--np-text-weak);
  flex-shrink: 0;
}
.lib__filter {
  flex-shrink: 0;
  min-width: 112rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: rgba(155,108,255,0.14);
  color: #7c3aed;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  border: 1rpx solid rgba(155,108,255,0.22);
}
.lib__fallback { background: #fff7ed; color: #b45309; padding: 16rpx 24rpx; border-radius: 12rpx; font-size: 24rpx; margin-bottom: 20rpx; }
.lib__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; }
