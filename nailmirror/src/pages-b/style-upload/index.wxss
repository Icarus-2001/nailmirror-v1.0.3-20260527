.su__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding: 24rpx 0 20rpx; }
.su__badge { flex: 0 0 auto; padding: 8rpx 16rpx; border: 1rpx solid var(--np-border); border-radius: 999rpx; color: var(--np-primary); font-size: 24rpx; background: var(--np-card); }
.su__tabs { display: flex; gap: 12rpx; margin-bottom: 24rpx; }
.su__tab {
  flex: 1;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: var(--np-text-weak);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 41, 0.04);
}
.su__tab--on {
  background: rgba(155, 108, 255, 0.14);
  color: #7c3aed;
  font-weight: 500;
}
.su__loading { text-align: center; color: var(--np-text-weak); font-size: 28rpx; padding: 48rpx 0; }
.su__panel { background: var(--np-card); border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.su__stat { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-bottom: 22rpx; }
.su__stat-item { min-width: 0; text-align: center; padding: 12rpx 8rpx; background: #f7f7fb; border-radius: 12rpx; }
.su__stat-num { display: block; font-size: 34rpx; font-weight: 700; line-height: 1.2; }
.su__stat-label { display: block; color: var(--np-text-weak); font-size: 22rpx; margin-top: 4rpx; }
.su__actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.su__action { text-align: center; }
.su__list { display: flex; flex-direction: column; gap: 18rpx; }
.su__row { display: flex; align-items: center; gap: 18rpx; padding: 18rpx; background: var(--np-card); border-radius: 16rpx; border: 1rpx solid transparent; }
.su__row--success { border-color: rgba(50, 180, 110, 0.28); }
.su__row--failed { border-color: rgba(255, 94, 138, 0.35); }
.su__row--uploading { opacity: 0.78; }
.su__thumb { width: 112rpx; height: 112rpx; border-radius: 12rpx; background: #f0f0f4; flex: 0 0 auto; }
.su__meta { flex: 1; min-width: 0; }
.su__name { font-size: 28rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.su__tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.su__error { color: var(--np-primary); font-size: 22rpx; margin-top: 8rpx; word-break: break-all; }
.su__status { flex: 0 0 auto; max-width: 132rpx; color: var(--np-text-weak); font-size: 24rpx; text-align: right; }
.su__footer { margin-top: 22rpx; }
.su__style-list { display: flex; flex-direction: column; gap: 18rpx; }
.su__style-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  background: var(--np-card);
  border-radius: 16rpx;
}
.su__style-cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #f0f0f4; flex: 0 0 auto; }
.su__style-meta { flex: 1; min-width: 0; }
.su__style-title { font-size: 28rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.su__status-badge {
  display: inline-block;
  margin-top: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}
.su__status-badge--on { background: rgba(50, 180, 110, 0.12); color: #1a9a55; }
.su__status-badge--off { background: #f3f4f6; color: #6b7280; }
.su__reactivate {
  flex: 0 0 auto;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #7c3aed;
  border: 1rpx solid rgba(124, 58, 237, 0.35);
}
.su__manage-hint {
  font-size: 24rpx;
  color: var(--np-text-weak);
  margin-bottom: 20rpx;
  line-height: 1.5;
}
.su__manage-list { display: flex; flex-direction: column; gap: 18rpx; }
.su__manage-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  background: var(--np-card);
  border-radius: 16rpx;
}
.su__manage-actions { display: flex; flex-direction: column; gap: 10rpx; flex: 0 0 auto; }
.su__manage-btn {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  text-align: center;
  border: 1rpx solid transparent;
}
.su__manage-btn--warn { color: #c45c26; border-color: rgba(196, 92, 38, 0.35); }
.su__manage-btn--danger { color: #e11d48; border-color: rgba(225, 29, 72, 0.35); }
