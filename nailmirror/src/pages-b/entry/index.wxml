<view class="be np-container">
  <view class="be__head">
    <view class="be__title">商家中心 · {{role === 'b' ? '已验证商家身份' : '普通用户'}}</view>
    <view class="be__hint" wx:if="{{role !== 'b'}}">完成身份认证后可使用商家经营功能</view>
    <view class="be__verified" wx:else>身份已通过平台验证，可使用全部商家功能</view>
  </view>

  <view wx:if="{{role !== 'b'}}" class="np-btn np-btn--block be__switch" bindtap="onSwitchToB">商家身份认证</view>
  <view wx:else class="np-btn np-btn--ghost np-btn--block be__switch" bindtap="onSwitchToC">退出商家模式</view>

  <view class="be__menu" wx:if="{{role === 'b'}}">
    <view class="be__item" bindtap="onGoDashboard">
      <text class="be__icon">📊</text>
      <text class="be__label">商家看板</text>
      <text class="be__arrow">›</text>
    </view>
    <view class="be__item" bindtap="onGoStyleUpload">
      <text class="be__icon">⬆️</text>
      <text class="be__label">上传款式</text>
      <text class="be__arrow">›</text>
    </view>
    <view class="be__item" bindtap="onGoStock">
      <text class="be__icon">📦</text>
      <text class="be__label">备货建议</text>
      <text class="be__arrow">›</text>
    </view>
    <view class="be__item" bindtap="onGoContact">
      <text class="be__icon">📞</text>
      <text class="be__label">轻预约配置</text>
      <text class="be__arrow">›</text>
    </view>
    <view class="be__item" bindtap="onGoHotRank">
      <text class="be__icon">🔥</text>
      <text class="be__label">热度详情</text>
      <text class="be__arrow">›</text>
    </view>
    <view class="be__item" bindtap="onGoMembership">
      <text class="be__icon">👑</text>
      <text class="be__label">付费方案</text>
      <text class="be__arrow">›</text>
    </view>
  </view>
</view>
