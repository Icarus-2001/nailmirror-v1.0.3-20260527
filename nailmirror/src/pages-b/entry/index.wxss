.be__phone-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 31, 41, 0.06);
}
.be__phone-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.be__phone-desc,
.be__phone-hint {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--np-text-weak);
}
.be__phone-num {
  margin: 28rpx 0 12rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.be__phone-btn {
  margin-top: 36rpx;
  width: 100%;
}
.be__phone-back {
  margin-top: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--np-text-weak);
}
.be__head { text-align: center; padding: 40rpx 0; }
.be__title { font-size: 36rpx; font-weight: 700; }
.be__hint { color: var(--np-text-weak); font-size: 24rpx; margin-top: 10rpx; }
.be__verified { color: #22c55e; font-size: 24rpx; margin-top: 10rpx; }
.be__switch { margin: 20rpx 0; }
.be__menu { background: rgba(255,255,255,0.95); border-radius: 28rpx; margin-top: 30rpx; padding: 4rpx 24rpx; box-shadow: 0 14rpx 36rpx rgba(31,31,41,0.06); }
.be__item { display: flex; align-items: center; padding: 30rpx 0; border-bottom: 1rpx solid rgba(239,239,245,0.85); font-size: 28rpx; }
.be__item:last-child { border-bottom: 0; }
.be__icon { font-size: 32rpx; margin-right: 20rpx; }
.be__label { flex: 1; }
.be__arrow { color: var(--np-text-weak); font-size: 32rpx; }
