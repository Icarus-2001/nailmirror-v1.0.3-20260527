.mr__card {
  margin-top: 120rpx;
  padding: 48rpx 36rpx;
  background: #fff;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(31, 31, 41, 0.06);
}
.mr__icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 24rpx;
  line-height: 88rpx;
  border-radius: 50%;
  background: #fff5ee;
  color: #c45c26;
  font-size: 44rpx;
  font-weight: 700;
}
.mr__title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.mr__desc,
.mr__hint {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--np-text-weak);
}
.mr__hint {
  margin-top: 16rpx;
}
.mr__btn {
  margin-top: 40rpx;
}
.mr__link {
  margin-top: 28rpx;
  font-size: 28rpx;
  color: var(--np-text-weak);
}
