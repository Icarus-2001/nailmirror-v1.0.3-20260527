.bd__head { padding: 24rpx 0 16rpx; }
.bd__alert {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  background: #fff8e6;
  border-radius: 12rpx;
  color: #92400e;
  font-size: 24rpx;
  line-height: 1.5;
}
.bd__health {
  margin-bottom: 20rpx;
  font-size: 22rpx;
  color: var(--np-text-weak);
}
.bd__loading {
  text-align: center;
  padding: 80rpx 0;
  color: var(--np-text-weak);
}
.bd__section {
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: var(--np-card);
  border-radius: 16rpx;
}
.bd__section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.bd__tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.bd__tab {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f7f7fb;
  color: var(--np-text-weak);
  font-size: 24rpx;
}
.bd__tab--on {
  background: rgba(124, 58, 237, 0.14);
  color: #7c3aed;
  font-weight: 500;
}
.bd__picker-title {
  margin-top: 20rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: var(--np-text-weak);
}
.bd__picker-hint {
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: var(--np-text-weak);
  line-height: 1.4;
}
.bd__picker-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--np-border);
  background: #fafafa;
}
.bd__picker-summary {
  flex: 1;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bd__picker-arrow {
  font-size: 22rpx;
  color: var(--np-text-weak);
  flex-shrink: 0;
}
.bd__picker-panel {
  margin-top: 12rpx;
  border: 1rpx solid var(--np-border);
  border-radius: 12rpx;
  overflow: hidden;
  background: #fff;
}
.bd__picker-scroll {
  max-height: 480rpx;
}
.bd__picker-done {
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  color: #7c3aed;
  border-top: 1rpx solid var(--np-border);
}
.bd__style-picks {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.bd__pick {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.bd__pick:last-child {
  border-bottom: none;
}
.bd__pick--on {
  border-color: rgba(124, 58, 237, 0.45);
  background: rgba(124, 58, 237, 0.06);
}
.bd__pick-check {
  width: 32rpx;
  color: #7c3aed;
  font-weight: 700;
}
.bd__pick-name {
  flex: 1;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bd__pick-heat {
  font-size: 24rpx;
  color: var(--np-text-weak);
}
.bd__trend-grid {
  display: flex;
  gap: 16rpx;
}
.bd__trend-col {
  flex: 1;
  min-width: 0;
}
.bd__trend-head {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.bd__trend-head--hot { color: #c45c26; }
.bd__trend-head--cold { color: #6b7280; }
.bd__trend-card {
  display: flex;
  gap: 12rpx;
  padding: 12rpx;
  margin-bottom: 12rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}
.bd__cover {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  background: #eee;
  flex-shrink: 0;
}
.bd__trend-meta { flex: 1; min-width: 0; }
.bd__trend-name {
  font-size: 24rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bd__trend-stat {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--np-text-weak);
}
.bd__trend-empty {
  font-size: 24rpx;
  color: var(--np-text-weak);
  padding: 16rpx 0;
}
.bd__rule-link {
  margin: -4rpx 0 12rpx;
  font-size: 22rpx;
  color: #576b95;
  text-decoration: underline;
}
.bd__pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 8rpx;
  padding-top: 8rpx;
}
.bd__pager-btn {
  font-size: 22rpx;
  color: #7c3aed;
  padding: 8rpx 12rpx;
}
.bd__pager-btn--off {
  color: #d1d5db;
  pointer-events: none;
}
.bd__pager-text {
  font-size: 22rpx;
  color: var(--np-text-weak);
}
