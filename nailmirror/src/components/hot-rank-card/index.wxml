<view class="hrc" bindtap="onTap" wx:if="{{item}}">
  <view class="hrc__rank hrc__rank--top{{rank <= 3 ? rank : 0}}">{{rank}}</view>
  <image class="hrc__cover" src="{{item.coverUrl}}" mode="aspectFill" lazy-load="{{true}}" wx:if="{{item.coverUrl}}"></image>
  <view class="hrc__cover hrc__cover--ph" wx:else>💅</view>
  <view class="hrc__body">
    <view class="hrc__title-row">
      <view class="hrc__title">{{item.title || item.styleId}}</view>
      <view wx:if="{{item.styleSource === 'xhs-hot'}}" class="hrc__badge hrc__badge--xhs">全网热款</view>
      <view wx:elif="{{item.styleSource === 'merchant-upload'}}" class="hrc__badge hrc__badge--merchant">来自商家</view>
      <view wx:elif="{{item.styleSource === 'platform' || item.styleSource}}" class="hrc__badge hrc__badge--platform">平台特供</view>
    </view>
    <view class="hrc__meta">
      <text wx:if="{{item.color}}" class="hrc__tag">{{item.color}}</text>
      <text wx:if="{{item.design}}" class="hrc__tag">{{item.design}}</text>
    </view>
    <view class="hrc__heat {{item.styleSource === 'xhs-hot' ? 'hrc__heat--xhs' : 'hrc__heat--site'}}">
      {{item.styleSource === 'xhs-hot' ? '📈' : '🔥'}} {{item.heat}}
    </view>
  </view>
</view>
