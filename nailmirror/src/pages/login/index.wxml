<view class="login np-container">
  <view class="login__logo">NailMirror</view>
  <view class="login__subtitle">AI 美甲试戴 · 高清出片 · 智能运营</view>

  <image class="login__hero" src="{{brandLogo}}" mode="aspectFit" />

  <view class="login__actions">
    <button
      class="np-btn np-btn--block login__btn"
      bindtap="onLogin"
      disabled="{{loading}}"
      hover-class="none"
    >微信一键登录</button>
    <view class="login__skip" bindtap="onSkip">先随便逛逛 ></view>
  </view>

  <view class="login__policy">登录即代表同意《隐私政策》与《用户协议》</view>

  <view wx:if="{{showProfileDialog}}" class="profile-dialog">
    <view class="profile-dialog__mask" bindtap="onCloseProfileDialog"></view>
    <view class="profile-dialog__panel">
      <view class="profile-dialog__title">确认微信资料</view>
      <view class="profile-dialog__desc">选头像后，在下方昵称框点一下并选用微信昵称</view>

      <view class="profile-dialog__avatar-wrap {{avatarChosen ? '' : 'profile-dialog__avatar-wrap--hint'}}">
        <button
          class="profile-dialog__avatar-btn"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
          hover-class="none"
          plain
        >
          <image
            class="profile-dialog__avatar"
            src="{{avatarUrl || brandLogo}}"
            mode="aspectFill"
          />
        </button>
      </view>
      <view class="profile-dialog__avatar-tip" wx:if="{{!avatarChosen}}">点击上方圆形头像</view>

      <input
        id="profileNicknameInput"
        class="profile-dialog__nickname"
        type="nickname"
        placeholder="点击此处选用微信昵称"
        bindfocus="onNicknameFocus"
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
        bindnicknamereview="onNicknameReview"
      />
      <view class="profile-dialog__nickname-ok" wx:if="{{nickname}}">已选用：{{nickname}}</view>

      <button
        class="np-btn np-btn--block profile-dialog__confirm"
        bindtap="onConfirmProfile"
        disabled="{{loading}}"
        hover-class="none"
      >{{loading ? '登录中...' : '确认并登录'}}</button>
      <view class="profile-dialog__cancel" bindtap="onCloseProfileDialog">暂不登录</view>
    </view>
  </view>

  <privacy-popup />
</view>
