<view class="sd" wx:if="{{style}}">
  <swiper class="sd__swiper" autoplay circular indicator-dots>
    <swiper-item wx:for="{{style.previewUrls}}" wx:key="*this">
      <image src="{{item}}" class="sd__img" mode="aspectFill"></image>
    </swiper-item>
  </swiper>

  <view class="sd__body np-container">
    <view class="sd__head-row">
      <view class="sd__title">{{style.title}}</view>
      <view wx:if="{{style.styleSource === 'xhs-hot'}}" class="sd__source sd__source--xhs">全网热款</view>
      <view wx:elif="{{style.styleSource === 'merchant-upload'}}" class="sd__source sd__source--merchant">来自商家</view>
      <view wx:elif="{{style.styleSource === 'platform'}}" class="sd__source sd__source--platform">平台特供</view>
    </view>
    <view class="sd__brief">{{style.brief}}</view>
    <view class="sd__tags" wx:if="{{displayTags.length}}">
      <text class="np-tag" wx:for="{{displayTags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
    </view>

    <view class="sd__metrics">
      <text wx:if="{{style.styleSource === 'xhs-hot'}}" class="sd__heat sd__heat--xhs">📈 {{style.heat}}</text>
      <text wx:else class="sd__heat sd__heat--site">🔥 {{style.heat}}</text>
      <text wx:if="{{style.tryonEffectText}}" class="sd__tryon">试戴效果 {{style.tryonEffectText}}</text>
      <text wx:if="{{style.qualityText}}" class="sd__quality">美甲品质 {{style.qualityText}}</text>
    </view>

    <view class="sd__merchant" wx:if="{{style.styleSource === 'merchant-upload' && merchantContact}}">
      <view class="np-title">{{merchantContact.storeName}}</view>
      <view class="np-subtitle" wx:if="{{merchantContact.province || merchantContact.city}}">{{merchantContact.province}} {{merchantContact.city}}</view>
      <view class="sd__phone" wx:if="{{merchantContact.phone}}" bindtap="onDialPhone">联系电话 {{merchantContact.phone}}</view>
    </view>
  </view>

  <view class="sd__bottom np-safe-bottom">
    <view class="sd__fav" bindtap="onFav">{{faved ? '♥ 已收藏' : '♡ 收藏'}}</view>
    <view class="sd__contact" bindtap="onContact">联系商家</view>
    <view class="np-btn sd__try" bindtap="onGoStatic">立即试戴</view>
  </view>
</view>
